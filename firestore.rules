rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isValidProject(data) {
      return data.titleAr is string && data.titleAr.size() > 0 && data.titleAr.size() < 256 &&
             data.titleEn is string && data.titleEn.size() > 0 && data.titleEn.size() < 256 &&
             data.category in ['lms', 'stem', 'ai', 'operations'] &&
             data.isPublished is bool;
    }

    function isValidOrder(data) {
      return data.userId is string && data.userId.size() > 0 &&
             data.planType in ['monthly', 'annual', 'full'] &&
             data.status in ['pending', 'active'];
    }

    function isValidDraft(data) {
      return data.visitorId is string && data.visitorId.size() > 0 &&
             data.status in ['pending_review', 'in_progress', 'completed', 'approved_published', 'rejected'] &&
             data.userPrompt is string && data.userPrompt.size() > 0 && data.userPrompt.size() < 2000;
    }

    // Projects
    match /projects/{projectId} {
      allow read: if isValidId(projectId) && (resource.data.isPublished == true || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isValidId(orderId) && isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(orderId) && isSignedIn() && request.resource.data.userId == request.auth.uid && isValidOrder(request.resource.data);
      allow update: if isValidId(orderId) && isAdmin();
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Drafts
    match /drafts/{draftId} {
      allow read: if isValidId(draftId) && isSignedIn() && (resource.data.visitorId == request.auth.uid || isAdmin());
      allow create: if isValidId(draftId) && isSignedIn() && request.resource.data.visitorId == request.auth.uid && isValidDraft(request.resource.data);
      allow update: if isValidId(draftId) && isSignedIn() && resource.data.visitorId == request.auth.uid && request.resource.data.visitorId == request.auth.uid && isValidDraft(request.resource.data);
      allow delete: if isValidId(draftId) && isAdmin();
    }
  }
}
